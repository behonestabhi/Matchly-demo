# Matchly AI service configuration. Copy to .env for local runs.
# Every value has a safe default; the service runs fully offline with none set.

# --- Embeddings ---
# Logical model name. With sentence-transformers installed this id is loaded;
# otherwise a deterministic hashing fallback (dim = EMBEDDING_DIM) is used.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# --- Persistence (optional) ---
# When set, embeddings are upserted into PostgreSQL + pgvector. When unset, an
# in-memory store is used. Requires psycopg to be installed for the DB path.
# DATABASE_URL=postgresql://matchly:matchly@postgres:5432/ai_db

# --- Matching weights (ARCHITECTURE §6.1) ---
WEIGHT_SEMANTIC=0.45
WEIGHT_SKILL=0.35
WEIGHT_EXPERIENCE=0.15
WEIGHT_EDUCATION=0.05

# --- Model versions ---
MATCH_MODEL_VERSION=match-v1.2

# --- LLM (optional; interview/roadmap fall back to templates if unset) ---
# Provider: template | openai | gemini. Provide the matching key.
LLM_PROVIDER=template
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-1.5-flash
LLM_TIMEOUT_SECONDS=30

# --- CORS ---
CORS_ALLOW_ORIGINS=*
