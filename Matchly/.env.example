# Copy to .env and adjust. docker-compose reads this file.

# --- Security ---
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1209600

# --- PostgreSQL ---
POSTGRES_USER=matchly
POSTGRES_PASSWORD=matchly
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# --- AI service ---
AI_SERVICE_URL=http://ai-service:8000
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- LLM (optional; interview-question generation falls back to templates if unset) ---
# Provide ONE of these. Leave blank to use the offline template generator.
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_PROVIDER=template   # template | openai | gemini

# --- Frontend ---
VITE_API_BASE=http://localhost:8080/api/v1
