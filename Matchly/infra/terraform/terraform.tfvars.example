# Copy to terraform.tfvars and adjust. DO NOT commit a tfvars containing secrets.
# Prefer passing db_password via TF_VAR_db_password or -var, not this file.

region = "us-east-1"
env    = "dev"

vpc_cidr = "10.0.0.0/16"
azs      = ["us-east-1a", "us-east-1b", "us-east-1c"]

# --- EKS ---
cluster_version     = "1.30"
node_instance_types = ["t3.large"]
node_desired_size   = 2
node_min_size       = 2
node_max_size       = 5

# --- RDS PostgreSQL ---
db_instance_class    = "db.t3.medium"
db_allocated_storage = 20
db_username          = "matchly"
# db_password is SENSITIVE — leave it out of this file. Provide it via:
#   export TF_VAR_db_password='...'        (recommended)
#   terraform apply -var="db_password=..."
# db_password = "DO_NOT_PUT_REAL_SECRETS_HERE"

# --- ElastiCache Redis ---
redis_node_type = "cache.t3.micro"

# --- MSK (Kafka) ---
msk_instance_type = "kafka.t3.small"
msk_broker_count  = 3
